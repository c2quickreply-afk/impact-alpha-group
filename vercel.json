{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data:; font-src 'self' https://fonts.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self' 'sha256-bmUEkFer6L5+w8hOsVaSJXsz9NErB8zS2mwGGDHnpeA=' 'sha256-2+yv+L36x3ZRHAGVsGWLjUHJrr2SCid3+QwA9q1VsAU='; connect-src 'self' https://formsubmit.co; upgrade-insecure-requests"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "accelerometer=(), autoplay=(), camera=(), display-capture=(), encrypted-media=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), usb=(), xr-spatial-tracking=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "same-origin"
        },
        {
          "key": "X-XSS-Protection",
          "value": "0"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "(www\\.)?impactalphagroup\\.com" }],
      "destination": "/alpha.html"
    },
    {
      "source": "/",
      "destination": "/earnings.html"
    }
  ],
  "redirects": [
    {
      "source": "/webinar",
      "has": [{ "type": "host", "value": "(www\\.)?impactearnings\\.com" }],
      "destination": "https://go.impactearnings.com/register-3624",
      "permanent": false
    },
    {
      "source": "/webinar/",
      "has": [{ "type": "host", "value": "(www\\.)?impactearnings\\.com" }],
      "destination": "https://go.impactearnings.com/register-3624",
      "permanent": false
    },
    {
      "source": "/newsletter",
      "has": [{ "type": "host", "value": "(www\\.)?impactearnings\\.com" }],
      "destination": "https://go.impactearnings.com/home-303039",
      "permanent": false
    },
    {
      "source": "/newsletter/",
      "has": [{ "type": "host", "value": "(www\\.)?impactearnings\\.com" }],
      "destination": "https://go.impactearnings.com/home-303039",
      "permanent": false
    },
    {
      "source": "/chatwithfrancene",
      "has": [{ "type": "host", "value": "(www\\.)?impactearnings\\.com" }],
      "destination": "https://go.impactearnings.com/chatwithfrancene",
      "permanent": false
    },
    {
      "source": "/chatwithfrancene/",
      "has": [{ "type": "host", "value": "(www\\.)?impactearnings\\.com" }],
      "destination": "https://go.impactearnings.com/chatwithfrancene",
      "permanent": false
    },
    {
      "source": "/alpha.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/earnings.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": false
    }
  ]
}
